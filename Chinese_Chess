                case 'b': return '象';
                case 'a': return '士';
                case 'k': return '将';
                case 'c': return '砲';
                case 'p': return '卒';
                default: return piece;
            }
        }
    }

    function colToChinese(col, isRed) {
        const redMap = ['九','八','七','六','五','四','三','二','一'];
        const blackMap = ['1','2','3','4','5','6','7','8','9'];
        return isRed ? redMap[col] : blackMap[8 - col];
    }

    function numToChinese(num, isRed) {
        if (!isRed) return num.toString();
        const chineseMap = ['', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
        return chineseMap[num] || num.toString();
    }

    function generateNotation(move, color) {
        const { piece, fromRow, fromCol, toRow, toCol } = move;
        if (!piece) return '?';
        const isRed = (color === 'red');
        const pieceChar = pieceToChinese(piece, color);
        
        // 检查是否有相同棋子在同一纵线
        let piecePrefix = '';
        let samePieceCount = 0;
        let frontPieceRow = -1;
        let backPieceRow = -1;
        
        for (let r = 0; r < ROWS; r++) {
            if (board[r][fromCol] === piece) {
                samePieceCount++;
                if (frontPieceRow === -1 || (isRed && r < frontPieceRow) || (!isRed && r > frontPieceRow)) {
                    frontPieceRow = r;
                }
                if (backPieceRow === -1 || (isRed && r > backPieceRow) || (!isRed && r < backPieceRow)) {
                    backPieceRow = r;
                }
            }
        }
        
        // 如果有两个相同的棋子在同一纵线，使用"前"和"后"来区分
        if (samePieceCount >= 2) {
            if (fromRow === frontPieceRow) {
                piecePrefix = '前';
            } else if (fromRow === backPieceRow) {
                piecePrefix = '后';
            }
        }
        
        const startColStr = colToChinese(fromCol, isRed);
        const endColStr = colToChinese(toCol, isRed);
        
        if (toRow === fromRow) {
            return piecePrefix + pieceChar + startColStr + '平' + endColStr;
        } else {
            let direction = '';
            if (isRed) {
                direction = (toRow < fromRow) ? '进' : '退';
            } else {
                direction = (toRow > fromRow) ? '进' : '退';
            }
            
            // 对于车、炮、兵（卒），使用移动的步数
            // 对于马、象、士，使用目标列的位置
            const pieceType = piece.toLowerCase();
            let stepOrCol;
            if (pieceType === 'r' || pieceType === 'c' || pieceType === 'p') {
                // 车、炮、兵（卒）使用步数，红方用汉字数字，黑方用阿拉伯数字
