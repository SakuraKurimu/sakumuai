                    // 沿方向移动，寻找炮架
                    while (r >= 0 && r < ROWS && c >= 0 && c < COLS) {
                        if (!foundPlatform) {
                            // 还没找到炮架，找第一个棋子作为炮架
                            if (board[r][c] !== EMPTY) {
                                foundPlatform = true;
                            }
                        } else {
                            // 已经找到炮架，找可以吃的棋子
                            if (board[r][c] !== EMPTY) {
                                const targetPiece = board[r][c];
                                // 只能吃对方的棋子
                                if (getPieceColor(targetPiece) !== getPieceColor(selectedPiece)) {
                                    const pt = getPointFromCell(r, c);
                                    // 绘制可吃子标记
                                    ctx.beginPath();
                                    ctx.fillStyle = 'rgba(255, 100, 100, 0.6)';
                                    ctx.arc(pt.x, pt.y, cellSize * 0.3, 0, 2 * Math.PI);
                                    ctx.fill();
                                    ctx.strokeStyle = 'rgba(255, 50, 50, 0.9)';
                                    ctx.lineWidth = 2;
                                    ctx.stroke();
                                    
                                    // 显示被吃的棋子
                                    const capturedPieceChar = pieceToChinese(targetPiece, 'red');
                                    ctx.fillStyle = 'rgba(255, 50, 50, 0.9)';
                                    ctx.font = 'bold 14px "Arial", sans-serif';
                                    ctx.textAlign = 'center';
                                    ctx.textBaseline = 'middle';
                                    ctx.fillText(capturedPieceChar, pt.x, pt.y);
                                    
                                    // 绘制从炮架到目标的虚线路径
                                    const platformRow = selectedRow + dr;
                                    const platformCol = selectedCol + dc;
                                    // 找到炮架位置
                                    let pr = selectedRow + dr;
                                    let pc = selectedCol + dc;
                                    while (pr >= 0 && pr < ROWS && pc >= 0 && pc < COLS && board[pr][pc] === EMPTY) {
                                        pr += dr;
                                        pc += dc;
                                    }
                                    if (pr >= 0 && pr < ROWS && pc >= 0 && pc < COLS && board[pr][pc] !== EMPTY) {
                                        const platformPt = getPointFromCell(pr, pc);
                                        ctx.beginPath();
                                        ctx.moveTo(platformPt.x, platformPt.y);
                                        ctx.lineTo(pt.x, pt.y);
                                        ctx.strokeStyle = 'rgba(255, 100, 100, 0.7)';
                                        ctx.lineWidth = 2;
                                        ctx.setLineDash([4, 4]);
                                        ctx.stroke();
                                        ctx.setLineDash([]);
                                    }
                                }
                                break; // 找到第一个可吃子就停止
                            }
                        }
                        r += dr;
                        c += dc;
                    }
                }
            }

            for (let move of legalMoves) {
                const pt = getPointFromCell(move.toRow, move.toCol);
                const targetPiece = board[move.toRow][move.toCol];
                const isCapture = targetPiece !== EMPTY;
                let isDangerous = isSquareAttacked(board, move.toRow, move.toCol, 'black');
                let isProtected = isSquareProtected(board, move.toRow, move.toCol, 'red');
                
                ctx.beginPath();
                if (isCapture) {
                    // 可吃子显示为黄色
                    ctx.fillStyle = 'rgba(255, 200, 0, 0.5)';
                    ctx.arc(pt.x, pt.y, cellSize * 0.25, 0, 2 * Math.PI);
                    ctx.fill();
                    
                    // 显示被吃的棋子
                    const capturedPieceChar = pieceToChinese(targetPiece, 'red');
                    ctx.fillStyle = 'rgba(255, 200, 0, 0.8)';
                    ctx.font = 'bold 14px "Arial", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(capturedPieceChar, pt.x, pt.y);
                } else if (isDangerous && !isProtected) {
                    ctx.fillStyle = 'rgba(255, 50, 50, 0.5)';
                    ctx.arc(pt.x, pt.y, cellSize * 0.25, 0, 2 * Math.PI);
                    ctx.fill();
                } else if (isDangerous && isProtected) {
                    ctx.fillStyle = 'rgba(50, 100, 255, 0.5)';
                    ctx.arc(pt.x, pt.y, cellSize * 0.25, 0, 2 * Math.PI);
                    ctx.fill();
                } else {
                    ctx.fillStyle = 'rgba(50, 200, 50, 0.5)';
                    ctx.arc(pt.x, pt.y, cellSize * 0.25, 0, 2 * Math.PI);
                    ctx.fill();
                }
            }
        }

        for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
                const piece = board[r][c];
                if (!piece) continue;
                const pt = getPointFromCell(r, c);
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, cellSize * 0.4, 0, 2 * Math.PI);
                ctx.fillStyle = (getPieceColor(piece) === 'red') ? '#cf4a4a' : '#2f4f4f';
                ctx.fill();
                ctx.strokeStyle = '#f5e6c4';
                ctx.lineWidth = 2;
                ctx.stroke();
                ctx.font = 'bold 30px "KaiTi", serif';
                ctx.fillStyle = '#fbf3d5';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(pieceToChinese(piece, getPieceColor(piece)), pt.x, pt.y);
            }
        }
        
        // 显示电脑落子路径
        if (lastAiMove) {
            const fromPt = getPointFromCell(lastAiMove.fromRow, lastAiMove.fromCol);
            const toPt = getPointFromCell(lastAiMove.toRow, lastAiMove.toCol);
            ctx.beginPath();
            ctx.moveTo(fromPt.x, fromPt.y);
            ctx.lineTo(toPt.x, toPt.y);
            ctx.strokeStyle = '#ff6b35';
            ctx.lineWidth = 3;
            ctx.setLineDash([5, 5]);
            ctx.stroke();
            ctx.setLineDash([]);
            
            // 起点标记
            ctx.beginPath();
            ctx.arc(fromPt.x, fromPt.y, cellSize * 0.2, 0, 2 * Math.PI);
            ctx.fillStyle = 'rgba(255, 107, 53, 0.7)';
            ctx.fill();
            
            // 终点标记
            ctx.beginPath();
            ctx.arc(toPt.x, toPt.y, cellSize * 0.3, 0, 2 * Math.PI);
            ctx.strokeStyle = '#ff6b35';
            ctx.lineWidth = 2;
            ctx.stroke();
        }

        // 显示提示
        if (currentHint) {
            const fromPt = getPointFromCell(currentHint.fromRow, currentHint.fromCol);
            const toPt = getPointFromCell(currentHint.toRow, currentHint.toCol);
            
            // 起点标记
            ctx.beginPath();
            ctx.arc(fromPt.x, fromPt.y, cellSize * 0.3, 0, 2 * Math.PI);
            ctx.strokeStyle = '#4CAF50';
            ctx.lineWidth = 3;
            ctx.stroke();
            
            // 终点标记
            ctx.beginPath();
            ctx.arc(toPt.x, toPt.y, cellSize * 0.4, 0, 2 * Math.PI);
            ctx.fillStyle = 'rgba(76, 175, 80, 0.3)';
            ctx.fill();
            ctx.strokeStyle = '#4CAF50';
            ctx.lineWidth = 2;
            ctx.stroke();
            
            // 连接线
            ctx.beginPath();
            ctx.moveTo(fromPt.x, fromPt.y);
            ctx.lineTo(toPt.x, toPt.y);
            ctx.strokeStyle = '#4CAF50';
            ctx.lineWidth = 2;
            ctx.setLineDash([3, 3]);
            ctx.stroke();
            ctx.setLineDash([]);
        }

        if (selectedRow !== -1 && selectedCol !== -1) {
            const pt = getPointFromCell(selectedRow, selectedCol);
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, cellSize * 0.45, 0, 2 * Math.PI);
            ctx.strokeStyle = '#ffd966';
            ctx.lineWidth = 5;
            ctx.stroke();
        }

        // 显示将军威胁
        if (currentPlayer === 'red' && isInCheck(board, 'red')) {
            const threats = getCheckThreats(board, 'red');
            const time = Date.now() / 500;
            const opacity = 0.5 + 0.5 * Math.sin(time);
            
            for (let threat of threats) {
                const fromPt = getPointFromCell(threat.fromRow, threat.fromCol);
                const toPt = getPointFromCell(threat.toRow, threat.toCol);
                
                // 进攻路径
                ctx.beginPath();
                ctx.moveTo(fromPt.x, fromPt.y);
                ctx.lineTo(toPt.x, toPt.y);
                ctx.strokeStyle = `rgba(255, 0, 0, ${opacity})`;
                ctx.lineWidth = 3;
                ctx.setLineDash([5, 5]);
                ctx.stroke();
                ctx.setLineDash([]);
                
                // 威胁棋子标记
                ctx.beginPath();
                ctx.arc(fromPt.x, fromPt.y, cellSize * 0.35, 0, 2 * Math.PI);
                ctx.strokeStyle = `rgba(255, 0, 0, ${opacity})`;
                ctx.lineWidth = 4;
                ctx.stroke();
            }
        }
    }

    canvas.addEventListener('click', handleCanvasClick);

    regretBtn.addEventListener('click', () => {
        regretMove();
    });

    restartBtn.addEventListener('click', () => {
        showModal('确认', '确定要开始新的一局吗？当前对局进度将丢失。', true, () => {
            restartGame();
        });
    });

    backToMenuBtn.addEventListener('click', () => {
        showModal('确认', '确定要返回主菜单吗？当前对局将自动保存。', true, () => {
            saveCurrentGame();
            showMainMenu();
        });
    });

    hintBtn.addEventListener('click', () => {
        if (gameOver || currentPlayer !== 'red') return;
        
        // 显示提示中状态
        gameStatusEl.innerText = '正在计算提示...';
        
        // 创建临时Worker来计算最佳走法
        const hintWorker = new Worker(workerUrl);
        hintWorker.onmessage = function(e) {
            const { move } = e.data;
            if (move) {
                currentHint = move;
                gameStatusEl.innerText = '提示已显示';
                drawBoard();
            } else {
                gameStatusEl.innerText = '无可用提示';
            }
            hintWorker.terminate();
        };
        
        hintWorker.postMessage({
            board: board,
            difficulty: gameSettings.difficulty,
            moveList: moveList,
            computeMode: computeMode,
            isHint: true
        });
    });

    function boardToFen() {
        let fen = '';
        for (let r = 0; r < ROWS; r++) {
            let emptyCount = 0;
            for (let c = 0; c < COLS; c++) {
                const piece = board[r][c];
                if (piece === EMPTY) {
                    emptyCount++;
                } else {
                    if (emptyCount > 0) {
                        fen += emptyCount;
                        emptyCount = 0;
                    }
                    fen += piece;
                }
            }
            if (emptyCount > 0) {
                fen += emptyCount;
            }
            if (r < ROWS - 1) {
                fen += '/';
            }
        }
        fen += ' ' + (currentPlayer === 'red' ? 'w' : 'b');
        return fen;
    }

    function fenToBoard(fen) {
        const parts = fen.split(' ');
        if (parts.length < 2) return false;
        
        const boardPart = parts[0];
        const rows = boardPart.split('/');
        
        if (rows.length !== ROWS) return false;
        
        const newBoard = [];
        for (let r = 0; r < ROWS; r++) {
            const rowStr = rows[r];
            const newRow = [];
            let col = 0;
            for (let i = 0; i < rowStr.length && col < COLS; i++) {
                const char = rowStr[i];
                if (char >= '0' && char <= '9') {
                    const count = parseInt(char);
                    for (let j = 0; j < count && col < COLS; j++) {
                        newRow.push(EMPTY);
                        col++;
                    }
                } else {
                    newRow.push(char);
                    col++;
                }
            }
            while (col < COLS) {
                newRow.push(EMPTY);
                col++;
            }
            newBoard.push(newRow);
        }
        
        return {
            board: newBoard,
            currentPlayer: parts[1] === 'w' ? 'red' : 'black'
        };
    }

    saveFenBtn.addEventListener('click', () => {
        const fen = boardToFen();
        navigator.clipboard.writeText(fen).then(() => {
            showModal('提示', 'FEN已复制到剪贴板！\n\n' + fen);
        }).catch(() => {
            prompt('请复制以下FEN字符串：', fen);
        });
    });

    loadFenBtn.addEventListener('click', () => {
        const fen = prompt('请输入FEN字符串：');
        if (!fen) return;
        
        const result = fenToBoard(fen);
        if (!result) {
            showModal('错误', '无效的FEN格式！');
            return;
        }
        
        board = result.board;
        currentPlayer = result.currentPlayer;
        gameOver = false;
        history = [];
        moveList = [];
        selectedRow = -1;
        selectedCol = -1;
        refreshMoveList();
        gameStatusEl.innerText = (currentPlayer === 'red' ? '红' : '黑') + '方走棋';
        drawBoard();
        
        if (currentPlayer === 'black') {
            aiMakeMove();
        }
    });

    restartGame();

    function gameLoop() {
        const currentlyInCheck = isInCheck(board, 'red');
        if (currentlyInCheck !== isRedInCheck) {
            isRedInCheck = currentlyInCheck;
        }
        
        if (isRedInCheck && currentPlayer === 'red') {
            drawBoard();
        }
        requestAnimationFrame(gameLoop);
    }
    gameLoop();
    
    window.startGame = startGame;
    window.showMainMenu = showMainMenu;
    window.showSettings = showSettings;
    window.showGameRecords = showGameRecords;
    window.loadGame = loadGame;
    window.deleteRecentGame = deleteRecentGame;
    window.deleteFavoriteGame = deleteFavoriteGame;
    window.addToFavorites = addToFavorites;
    window.showModal = showModal;
    window.closeModal = closeModal;
    window.restartGame = restartGame;
    window.applySettingsToGame = applySettingsToGame;
})();
</script>
</body>
</html>
