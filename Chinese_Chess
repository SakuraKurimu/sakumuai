                // 过河后左右走
                if (fromRow >= 5 && toRow === fromRow && Math.abs(deltaCol) === 1) return true;
                return false;
            }
        }
        return false;
    }

    function moveWouldLeaveSelfInCheck(board, fromRow, fromCol, toRow, toCol, color) {
        const newBoard = copyBoard(board);
        const piece = newBoard[fromRow][fromCol];
        newBoard[fromRow][fromCol] = EMPTY;
        newBoard[toRow][toCol] = piece;
        return isInCheck(newBoard, color) || kingsFacing(newBoard);
    }

    function getAllLegalMoves(board, color) {
        let moves = [];
        for (let r=0; r<ROWS; r++) {
            for (let c=0; c<COLS; c++) {
                const piece = board[r][c];
                if (!piece) continue;
                if (getPieceColor(piece) !== color) continue;
                for (let tr=0; tr<ROWS; tr++) {
                    for (let tc=0; tc<COLS; tc++) {
                        if (r===tr && c===tc) continue;
                        const target = board[tr][tc];
                        if (target && sameColor(piece, target)) continue;
                        if (!isValidAttack(board, piece, r, c, tr, tc)) continue;
                        if (moveWouldLeaveSelfInCheck(board, r, c, tr, tc, color)) continue;
                        moves.push({
                            fromRow: r, fromCol: c,
                            toRow: tr, toCol: tc,
                            piece: piece
                        });
                    }
                }
            }
        }
        return moves;
    }

    function isCheckmate(board, color) {
        const moves = getAllLegalMoves(board, color);
        return moves.length === 0;
    }

    function isSquareAttacked(board, row, col, byColor) {
        for (let r=0; r<ROWS; r++) {
            for (let c=0; c<COLS; c++) {
                const piece = board[r][c];
                if (piece && getPieceColor(piece) === byColor) {
                    const pieceType = piece.toLowerCase();
                    if (pieceType === 'c') {
                        // 炮的攻击判断：需要有炮架
                        if (board[row][col] === EMPTY) {
                            continue;
                        }
                        if (r === row && c === col) {
                            continue;
                        }
                        if (r !== row && c !== col) {
                            continue;
                        }
                        let cnt = 0;
                        const stepRow = (row - r) / Math.abs(row - r) || 0;
                        const stepCol = (col - c) / Math.abs(col - c) || 0;
                        let currentR = r + stepRow;
                        let currentC = c + stepCol;
                        while (currentR !== row || currentC !== col) {
                            if (board[currentR][currentC] !== EMPTY) {
                                cnt++;
                            }
                            currentR += stepRow;
                            currentC += stepCol;
                        }
                        if (cnt === 1) {
                            return true;
                        }
                    } else {
                        if (isValidAttack(board, piece, r, c, row, col)) {
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }

    function isSquareProtected(board, row, col, byColor) {
        const tempBoard = copyBoard(board);
        tempBoard[row][col] = (byColor === 'red') ? 'P' : 'p';
        for (let r=0; r<ROWS; r++) {
            for (let c=0; c<COLS; c++) {
                const piece = tempBoard[r][c];
                if (piece && getPieceColor(piece) === byColor && !(r === row && c === col)) {
                    if (isValidAttack(tempBoard, piece, r, c, row, col)) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    function getCellFromPoint(x, y) {
        const col = Math.round((x - padding) / cellSize);
        const row = Math.round((y - padding) / cellSize);
        if (row >= 0 && row < ROWS && col >= 0 && col < COLS) {
            return { row, col };
        }
        return null;
    }

    function getPointFromCell(row, col) {
        return {
            x: padding + col * cellSize,
            y: padding + row * cellSize
        };
    }

    function animateMove(fromRow, fromCol, toRow, toCol, piece, callback) {
        const startPt = getPointFromCell(fromRow, fromCol);
        const endPt = getPointFromCell(toRow, toCol);
        const startTime = Date.now();
        const duration = 300; // 动画持续时间（毫秒）
        
        // 临时清除原位置的棋子
        const originalPiece = board[fromRow][fromCol];
        board[fromRow][fromCol] = EMPTY;
        
        function animate() {
            const elapsed = Date.now() - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            // 使用缓动函数
            const easeProgress = 1 - Math.pow(1 - progress, 3);
            
            const currentX = startPt.x + (endPt.x - startPt.x) * easeProgress;
            const currentY = startPt.y + (endPt.y - startPt.y) * easeProgress;
            
            // 重绘棋盘和棋子（不包含移动的棋子）
            drawBoard();
            
            // 绘制移动中的棋子 - 使用与drawBoard相同的样式
            ctx.beginPath();
            ctx.arc(currentX, currentY, cellSize * 0.4, 0, 2 * Math.PI);
            ctx.fillStyle = getPieceColor(piece) === 'red' ? '#cf4a4a' : '#2f4f4f';
            ctx.fill();
            ctx.strokeStyle = '#f5e6c4';
            ctx.lineWidth = 2;
            ctx.stroke();
            
            // 绘制棋子文本 - 使用与drawBoard相同的样式
            ctx.font = 'bold 30px "KaiTi", serif';
            ctx.fillStyle = '#fbf3d5';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(pieceToChinese(piece, getPieceColor(piece)), currentX, currentY);
            
            if (progress < 1) {
                requestAnimationFrame(animate);
            } else {
                // 恢复原位置的棋子
                board[fromRow][fromCol] = originalPiece;
                // 执行实际的移动操作
                board[fromRow][fromCol] = EMPTY;
                board[toRow][toCol] = piece;
                callback();
            }
        }
        
        animate();
    }

    function executeMove(fromRow, fromCol, toRow, toCol) {
        const piece = board[fromRow][fromCol];
        const move = { fromRow, fromCol, toRow, toCol, piece };
        const notation = generateNotation(move, 'red');
        pushHistory(move, notation);

        // 播放移动动画
        animateMove(fromRow, fromCol, toRow, toCol, piece, () => {
            moveList.push(notation);
            refreshMoveList();

            selectedRow = -1;
            selectedCol = -1;
            currentHint = null;
            lastAiMove = null;
            drawBoard();

            if (isCheckmate(board, 'black')) {
                gameOver = true;
                gameStatusEl.innerText = '红方胜利！';
                return;
            }

            currentPlayer = 'black';
            gameStatusEl.innerText = '黑方走棋';
            drawBoard();

            aiMakeMove();
        });
    }
    


