    function pieceToChinese(piece, color) {
        if (!piece) return '';
        const lower = piece.toLowerCase();
        if (color === 'red') {
            switch(lower) {
                case 'r': return '俥';
                case 'n': return '傌';
                case 'b': return '相';
                case 'a': return '仕';
                case 'k': return '帅';
                case 'c': return '炮';
                case 'p': return '兵';
                default: return piece;
