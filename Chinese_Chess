<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>中国象棋</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
        }
        body {
            background: #2b5a3a;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
            margin: 0;
            padding: 16px;
        }
        .game-container {
            display: flex;
            flex-wrap: nowrap;
            background: #e8d5b5;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 20px 30px rgba(0,0,0,0.6);
            max-width: 1200px;
            width: fit-content;
            gap: 24px;
        }
        .record-panel {
            width: 220px;
            background: #f0e2c5;
            border-radius: 20px;
            padding: 16px 10px;
            box-shadow: inset 0 0 0 2px #baa07a, 0 8px 12px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            height: 600px;
        }
        .record-panel h3 {
            text-align: center;
            margin: 0 0 12px 0;
            color: #3d2a1a;
            font-weight: 600;
            font-size: 1.4rem;
            border-bottom: 2px solid #b59e7c;
            padding-bottom: 6px;
        }
        .move-list {
            flex: 1;
            overflow-y: auto;
            padding-left: 20px;
            font-size: 1.1rem;
            color: #2c1e12;
            list-style-type: cjk-ideographic;
        }
        .move-list li {
            margin-bottom: 6px;
            font-family: 'KaiTi', '楷体', monospace;
            border-bottom: 1px dotted #c2aa88;
            padding: 2px 0;
        }
        .move-list li.red-move {
            color: #b02b2b;
        }
        .move-list li.black-move {
            color: #1e3a3a;
        }
        .board-area {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        canvas {
            display: block;
            border-radius: 18px;
            box-shadow: 0 0 0 4px #6f4f2e, 0 12px 24px black;
            background: #e3c184;
            cursor: pointer;
        }
        .control-panel {
            width: 220px;
            background: #f0e2c5;
            border-radius: 20px;
            padding: 16px 10px;
            box-shadow: inset 0 0 0 2px #baa07a, 0 8px 12px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            height: 600px;
        }
        .control-panel h3 {
            margin: 0 0 16px 0;
            font-size: 1.3rem;
            color: #3b2c18;
            text-align: center;
            font-weight: bold;
        }
        .controls {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 16px;
        }
        .difficulty-select {
            background: #fcf3e0;
            border: 2px solid #7b5f3a;
            border-radius: 32px;
            padding: 6px 14px;
            font-size: 1.1rem;
            font-weight: bold;
            color: #2d1f0f;
            cursor: pointer;
            outline: none;
        }
        button {
            background: #f5e7cc;
            border: none;
            border-radius: 40px;
            padding: 12px 16px;
            font-size: 1rem;
            font-weight: bold;
            color: #3b2c18;
            border: 2px solid #8b6f48;
            box-shadow: 0 4px 0 #5d4a2e;
            cursor: pointer;
            transition: 0.1s linear;
            letter-spacing: 1px;
            width: 100%;
            text-align: center;
        }
        button:active {
            transform: translateY(4px);
            box-shadow: none;
        }
        button:disabled {
            opacity: 0.5;
            pointer-events: none;
            transform: none;
        }
        .status {
            font-size: 1.1rem;
            font-weight: bold;
            background: #3e5d4c;
            color: #efdfb7;
            padding: 10px 16px;
            border-radius: 40px;
            box-shadow: inset 0 -2px 0 #1d3327;
            text-align: center;
            margin-bottom: 16px;
        }
        .status.thinking {
            background: #b02b2b;
            animation: pulse 1s infinite;
        }
        .ai-settings {
            position: absolute;
            top: 16px;
            right: 16px;
            background: #f0e2c5;
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            z-index: 1000;
            min-width: 200px;
        }
        .ai-settings h4 {
            margin: 0 0 12px 0;
            color: #3d2a1a;
            font-size: 1.1rem;
            border-bottom: 2px solid #b59e7c;
            padding-bottom: 8px;
        }
        .ai-settings label {
            display: block;
            margin-bottom: 8px;
            color: #2c1e12;
            font-size: 0.95rem;
        }
        .ai-settings select {
            width: 100%;
            background: #fcf3e0;
            border: 2px solid #7b5f3a;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 0.95rem;
            font-weight: bold;
            color: #2d1f0f;
            cursor: pointer;
            outline: none;
            margin-bottom: 12px;
        }
        .ai-timer {
            background: #3e5d4c;
            color: #efdfb7;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: bold;
            text-align: center;
            box-shadow: inset 0 -2px 0 #1d3327;
        }
        .ai-timer.thinking {
            background: #b02b2b;
            animation: pulse 1s infinite;
        }
        .check-warning {
            background: #d9534f;
            color: #fff;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: bold;
            text-align: center;
            margin-top: 8px;
            animation: blink 0.5s infinite alternate;
        }
        .game-footer {
            text-align: center;
            color: #8b7355;
            font-size: 11px;
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid #c2aa88;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        @keyframes blink {
            from { opacity: 1; }
            to { opacity: 0.5; }
        }

        /* 自定义弹窗样式 */
        .custom-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }
        .modal-content {
            background: #f0e2c5;
            border-radius: 20px;
            padding: 0;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            max-width: 400px;
            width: 90%;
            animation: modalSlideIn 0.3s ease-out;
        }
        @keyframes modalSlideIn {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            border-bottom: 2px solid #baa07a;
            background: #e8d5b5;
            border-radius: 20px 20px 0 0;
        }
        .modal-header h3 {
            margin: 0;
            font-size: 1.3rem;
            color: #3b2c18;
        }
        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #3b2c18;
            cursor: pointer;
            padding: 0;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: 0.2s;
        }
        .modal-close:hover {
            background: rgba(59, 44, 24, 0.1);
        }
        .modal-body {
            padding: 24px 20px;
            color: #3b2c18;
            font-size: 1rem;
            line-height: 1.6;
        }
        .modal-body p {
            margin: 0;
        }
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding: 16px 20px;
            border-top: 1px solid #baa07a;
        }
        .modal-btn {
            padding: 10px 24px;
            border-radius: 24px;
            font-size: 1rem;
            font-weight: bold;
            border: 2px solid;
            cursor: pointer;
            transition: 0.2s;
            min-width: 80px;
        }
        .modal-btn-cancel {
            background: #f5e7cc;
            border-color: #8b6f48;
            color: #3b2c18;
        }
        .modal-btn-cancel:hover {
            background: #e8d5b5;
        }
        .modal-btn-confirm {
            background: #3e5d4c;
            border-color: #2d4235;
            color: #efdfb7;
        }
        .modal-btn-confirm:hover {
            background: #4a6d5a;
        }

        /* 主菜单样式 */
        .main-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #2b5a3a 0%, #1a3d2a 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .menu-container {
            text-align: center;
            background: rgba(232, 213, 181, 0.95);
            border-radius: 32px;
            padding: 48px 64px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            max-width: 500px;
            width: 90%;
        }

        .logo-section {
            margin-bottom: 48px;
        }

        .chess-pieces {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            margin-bottom: 24px;
        }

        .piece {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px;
            font-weight: bold;
            font-family: 'KaiTi', '楷体', serif;
            box-shadow: 0 8px 16px rgba(0,0,0,0.3);
            border: 3px solid #6f4f2e;
        }

        .red-piece {
            background: linear-gradient(135deg, #cf4a4a 0%, #b02b2b 100%);
            color: #fbf3d5;
        }

        .black-piece {
            background: linear-gradient(135deg, #2f4f4f 0%, #1e3a3a 100%);
            color: #fbf3d5;
        }

        .vs-text {
            font-size: 48px;
            font-weight: bold;
            color: #cf4a4a;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
            font-family: 'Arial Black', sans-serif;
            letter-spacing: 4px;
        }

        .game-title {
            font-size: 56px;
            color: #3d2a1a;
            margin: 0 0 12px 0;
            font-family: 'KaiTi', '楷体', serif;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        .subtitle {
            font-size: 18px;
            color: #6b5b4f;
            margin: 0;
            font-weight: 500;
        }

        .menu-buttons {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 48px;
        }

        .menu-btn {
            padding: 16px 32px;
            font-size: 20px;
            border: none;
            border-radius: 32px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
            font-weight: 600;
            background: #cfb691;
            color: #3d2a1a;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .menu-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
        }

        .menu-btn:active {
            transform: translateY(0);
        }

        .primary-btn {
            background: linear-gradient(135deg, #cf4a4a 0%, #b02b2b 100%);
            color: #fbf3d5;
            font-size: 24px;
            padding: 20px 40px;
        }

        .primary-btn:hover {
            background: linear-gradient(135deg, #d95a5a 0%, #c03b3b 100%);
        }

        .copyright {
            font-size: 14px;
            color: #8b7355;
            border-top: 1px solid #c2aa88;
            padding-top: 16px;
        }

        /* 设置界面样式 */
        .settings-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #2b5a3a 0%, #1a3d2a 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            overflow-y: auto;
        }

        .settings-container {
            background: rgba(232, 213, 181, 0.95);
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .settings-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid #c2aa88;
        }

        .settings-header h2 {
            margin: 0;
            color: #3d2a1a;
            font-size: 28px;
        }

        .back-btn {
            background: #cfb691;
            border: none;
            border-radius: 20px;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 16px;
            color: #3d2a1a;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: #dec7a1;
        }

        .settings-content {
            margin-bottom: 24px;
        }

        .settings-section {
            margin-bottom: 24px;
        }

        .settings-section h3 {
            color: #3d2a1a;
            font-size: 20px;
            margin-bottom: 16px;
            border-left: 4px solid #cf4a4a;
            padding-left: 12px;
        }

        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e0d0b0;
        }

        .setting-item label:first-child {
            color: #5d4a3a;
            font-size: 16px;
            font-weight: 500;
        }

        .setting-select {
            background: #fcf3e0;
            border: 2px solid #7b5f3a;
            border-radius: 16px;
            padding: 8px 16px;
            font-size: 14px;
            color: #3d2a1a;
            cursor: pointer;
        }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
            cursor: pointer;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 26px;
        }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        .toggle-switch input:checked + .toggle-slider {
            background-color: #cf4a4a;
        }

        .toggle-switch input:checked + .toggle-slider:before {
            transform: translateX(24px);
        }

        .settings-footer {
            text-align: center;
        }

        .save-btn {
            background: linear-gradient(135deg, #cf4a4a 0%, #b02b2b 100%);
            color: #fbf3d5;
            border: none;
            border-radius: 24px;
            padding: 12px 32px;
            font-size: 18px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
        }

        /* 对局记录界面样式 */
        .records-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #2b5a3a 0%, #1a3d2a 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            overflow-y: auto;
        }

        .records-container {
            background: rgba(232, 213, 181, 0.95);
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            max-width: 800px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .records-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid #c2aa88;
        }

        .records-header h2 {
            margin: 0;
            color: #3d2a1a;
            font-size: 28px;
        }

        .records-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .records-section h3 {
            color: #3d2a1a;
            font-size: 20px;
            margin-bottom: 16px;
            border-left: 4px solid #cf4a4a;
            padding-left: 12px;
        }

        .games-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .game-record {
            background: #f5e6d0;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
            border-left: 4px solid #7b5f3a;
            transition: all 0.3s ease;
        }

        .game-record:hover {
            transform: translateX(4px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .game-record-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .game-record-title {
            font-weight: 600;
            color: #3d2a1a;
            font-size: 16px;
        }

        .game-record-date {
            font-size: 12px;
            color: #8b7355;
        }

        .game-record-info {
            font-size: 14px;
            color: #5d4a3a;
            margin-bottom: 8px;
        }

        .game-record-actions {
            display: flex;
            gap: 8px;
        }

        .record-action-btn {
            background: #cfb691;
            border: none;
            border-radius: 16px;
            padding: 6px 12px;
            font-size: 12px;
            cursor: pointer;
            color: #3d2a1a;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .record-action-btn:hover {
            background: #dec7a1;
        }

        .record-action-btn.delete {
            background: #cf4a4a;
            color: #fbf3d5;
        }

        .record-action-btn.delete:hover {
            background: #d95a5a;
        }

        .empty-message {
            text-align: center;
            color: #8b7355;
            font-style: italic;
            padding: 24px;
        }
    </style>
</head>
<body>

<!-- 主菜单界面 -->
<div id="mainMenu" class="main-menu">
    <div class="menu-container">
        <div class="logo-section">
            <div class="chess-pieces">
                <div class="piece red-piece">帅</div>
                <div class="vs-text">VS</div>
                <div class="piece black-piece">将</div>
            </div>
            <h1 class="game-title">中国象棋</h1>
            <p class="subtitle">樱梦象棋AI引擎</p>
        </div>
        
        <div class="menu-buttons">
            <button class="menu-btn primary-btn" onclick="startGame()">开始游戏</button>
            <button class="menu-btn" onclick="showSettings()">设置</button>
            <button class="menu-btn" onclick="showGameRecords()">对局记录</button>
        </div>
        
        <div class="copyright">
            樱梦象棋AI © 2026 | Made by 樱玖璃梦
        </div>
    </div>
</div>

<!-- 设置界面 -->
<div id="settingsMenu" class="settings-menu" style="display: none;">
    <div class="settings-container">
        <div class="settings-header">
            <h2>设置</h2>
            <button class="back-btn" onclick="showMainMenu()">← 返回</button>
        </div>
        
        <div class="settings-content">
            <div class="settings-section">
                <h3>AI设置</h3>
                <div class="setting-item">
                    <label>难度:</label>
                    <select id="menuDifficultySelect" class="setting-select">
                        <option value="0">🌱入门</option>
                        <option value="1" selected>🍂普通</option>
                        <option value="2">🗻进阶</option>
                        <option value="3">👑大师</option>
                        <option value="4">🏆宗师</option>
                    </select>
                </div>
                <div class="setting-item">
                    <label>计算模式:</label>
                    <select id="menuComputeMode" class="setting-select">
                        <option value="cpu">CPU模式</option>
                        <option value="gpu" selected>GPU模式</option>
                    </select>
                </div>
            </div>
            
            <div class="settings-section">
                <h3>游戏功能</h3>
                <div class="setting-item">
                    <label>启用提示:</label>
                    <label class="toggle-switch">
                        <input type="checkbox" id="hintEnabled">
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="setting-item">
                    <label>启用悔棋:</label>
                    <label class="toggle-switch">
                        <input type="checkbox" id="regretEnabled" checked>
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="setting-item">
                    <label>启用FEN保存和导入:</label>
                    <label class="toggle-switch">
                        <input type="checkbox" id="fenEnabled">
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        </div>
        
        <div class="settings-footer">
            <button class="save-btn" onclick="saveSettings()">保存设置</button>
        </div>
    </div>
</div>

<!-- 对局记录界面 -->
<div id="recordsMenu" class="records-menu" style="display: none;">
    <div class="records-container">
        <div class="records-header">
            <h2>记录</h2>
            <button class="back-btn" onclick="showMainMenu()">← 返回</button>
        </div>
        
        <div class="records-content">
            <div class="records-section">
                <h3>最近对局</h3>
                <div id="recentGames" class="games-list">
                    <p class="empty-message">暂无对局记录</p>
                </div>
            </div>
            
            <div class="records-section">
                <h3>收藏对局</h3>
                <div id="favoriteGames" class="games-list">
