    // 获取棋子位置评分
    function getPosBonus(piece, row, col) {
        const p = piece.toLowerCase();
        let bonus = 0;
        if (p === 'p') {
            bonus = piece === 'P' ? pawnPosBonus[row][col] : pawnPosBonus[9-row][col];
        } else if (p === 'r') {
            bonus = piece === 'R' ? rookPosBonus[row][col] : rookPosBonus[9-row][col];
        } else if (p === 'n') {
            bonus = piece === 'N' ? knightPosBonus[row][col] : knightPosBonus[9-row][col];
        } else if (p === 'c') {
            bonus = piece === 'C' ? cannonPosBonus[row][col] : cannonPosBonus[9-row][col];
        } else if (p === 'a') {
            bonus = piece === 'A' ? advisorPosBonus[row][col] : advisorPosBonus[9-row][col];
        } else if (p === 'b') {
            bonus = piece === 'B' ? bishopPosBonus[row][col] : bishopPosBonus[9-row][col];
        }
        return bonus;
    }

    // 评估棋盘局面
    function evaluateBoard(b) {
        let score = 0;
        let redMaterial = 0, blackMaterial = 0;
        
        for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
                const p = b[r][c];
                if (!p) continue;
                
                let val = pieceValues[p] || 0;
                val += getPosBonus(p, r, c);
                
                // 机动性奖励
                const moves = getAllLegalMoves(b, getPieceColor(p));
                const pieceMoves = moves.filter(m => m.fromRow === r && m.fromCol === c).length;
                val += pieceMoves * 5;
                
                if (p === p.toLowerCase()) {
                    score -= val;
                    blackMaterial += pieceValues[p];
                } else {
                    score += val;
                    redMaterial += pieceValues[p];
                }
            }
        }
        
        // 将军惩罚/奖励
        if (isInCheck(b, 'red')) score -= 150;
        if (isInCheck(b, 'black')) score += 150;
        
        // 将死检测
        if (isCheckmate(b, 'red')) score -= 50000;
        if (isCheckmate(b, 'black')) score += 50000;
        
        return score;
    }

    // 迭代加深搜索
    function minimax(b, depth, alpha, beta, isMaximizing, maxDepth) {
        // 静态评估 - 到达叶子节点
        if (depth === 0) {
            return quiescenceSearch(b, alpha, beta, isMaximizing, 8);
        }
        
        const color = isMaximizing ? 'red' : 'black';
        const moves = getAllLegalMoves(b, color);
        
        if (moves.length === 0) {
            return isMaximizing ? -100000 - depth : 100000 + depth;
        }
        
        // 移动排序 - 提高剪枝效率
        moves.sort((moveA, moveB) => {
            let scoreA = 0, scoreB = 0;
            // 吃子优先
            if (b[moveA.toRow][moveA.toCol]) scoreA += pieceValues[b[moveA.toRow][moveA.toCol]] || 0;
            if (b[moveB.toRow][moveB.toCol]) scoreB += pieceValues[b[moveB.toRow][moveB.toCol]] || 0;
            // 历史启发
            return scoreB - scoreA;
        });
        
        if (isMaximizing) {
            let maxEval = -Infinity;
            for (let move of moves) {
                const newB = copyBoard(b);
                newB[move.fromRow][move.fromCol] = EMPTY;
                newB[move.toRow][move.toCol] = move.piece;
                const evalScore = minimax(newB, depth - 1, alpha, beta, false, maxDepth);
                maxEval = Math.max(maxEval, evalScore);
                alpha = Math.max(alpha, evalScore);
                if (beta <= alpha) break;
            }
            return maxEval;
        } else {
            let minEval = Infinity;
            for (let move of moves) {
                const newB = copyBoard(b);
                newB[move.fromRow][move.fromCol] = EMPTY;
                newB[move.toRow][move.toCol] = move.piece;
                const evalScore = minimax(newB, depth - 1, alpha, beta, true, maxDepth);
                minEval = Math.min(minEval, evalScore);
                beta = Math.min(beta, evalScore);
                if (beta <= alpha) break;
            }
            return minEval;
        }
    }

    // 静态搜索 - 解决水平线问题
    function quiescenceSearch(b, alpha, beta, isMaximizing, depth) {
        const standPat = evaluateBoard(b);
        
        if (isMaximizing) {
            if (standPat >= beta) return beta;
            if (alpha < standPat) alpha = standPat;
        } else {
            if (standPat <= alpha) return alpha;
            if (beta > standPat) beta = standPat;
        }
        
        if (depth === 0) return standPat;
        
        const color = isMaximizing ? 'red' : 'black';
        const moves = getAllLegalMoves(b, color);
        
        // 只考虑吃子着法
        const captureMoves = moves.filter(m => b[m.toRow][m.toCol] !== EMPTY);
        
        if (isMaximizing) {
            for (let move of captureMoves) {
                const capturedValue = pieceValues[b[move.toRow][move.toCol]] || 0;
                // Delta剪枝
                if (standPat + capturedValue + 200 < alpha) continue;
                
                const newB = copyBoard(b);
                newB[move.fromRow][move.fromCol] = EMPTY;
                newB[move.toRow][move.toCol] = move.piece;
                const score = quiescenceSearch(newB, alpha, beta, false, depth - 1);
                if (score >= beta) return beta;
                if (score > alpha) alpha = score;
            }
            return alpha;
        } else {
            for (let move of captureMoves) {
                const capturedValue = pieceValues[b[move.toRow][move.toCol]] || 0;
                if (standPat - capturedValue - 200 > beta) continue;
                
                const newB = copyBoard(b);
                newB[move.fromRow][move.fromCol] = EMPTY;
                newB[move.toRow][move.toCol] = move.piece;
                const score = quiescenceSearch(newB, alpha, beta, true, depth - 1);
                if (score <= alpha) return alpha;
                if (score < beta) beta = score;
            }
            return beta;
        }
    }

